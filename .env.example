# Required ----------------------------------------------------
GITHUB_TOKEN=ghp_xxx                      # PAT with Contents: R/W on the data repo
ANTHROPIC_API_KEY=sk-ant-xxx              # For PDF/image auto-extraction
APP_PASSWORD=change-me-please             # Login password
AUTH_SECRET=any-long-random-string        # Used to sign session cookie (16+ chars)

