# GitHub data repository (where records are stored)
GITHUB_TOKEN=ghp_xxx                      # Personal Access Token with `repo` scope on the data repo
GITHUB_DATA_OWNER=yourjini                # GitHub username/org that owns the data repo
GITHUB_DATA_REPO=MyDoctor_db              # Name of the private data repo
GITHUB_DATA_BRANCH=main                   # Branch to read/write (default: main)

# Anthropic API (for PDF/image auto-extraction)
ANTHROPIC_API_KEY=sk-ant-xxx

# Simple password auth (single-user)
APP_PASSWORD=change-me-please             # Login password
AUTH_SECRET=any-long-random-string        # Used to sign session cookie
