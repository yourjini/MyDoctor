# Required ----------------------------------------------------
GITHUB_TOKEN=ghp_xxx                      # PAT with Contents: R/W on the data repo
APP_PASSWORD=change-me-please             # 메인 로그인 비밀번호
AUTH_SECRET=any-long-random-string        # 세션 쿠키 서명용 (16자 이상)
DIARY_PASSWORD=change-me-too              # /diary 2차 비밀번호 (앱 로그인 위에 한 번 더 잠금)

# Vercel 자동 주입 (로컬에서만 수동 설정) --------------------
# Vercel 프로젝트에 Blob 스토어를 연결하면 자동으로 들어가므로 production에서는 설정 불필요.
# 로컬에서 /checkups 파일 업로드를 돌려보려면 이 값만 수동으로 넣으면 됨.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional (기본값 있음) ---------------------------------------
# GITHUB_DATA_OWNER=yourjini              # default: yourjini
# GITHUB_DATA_REPO=MyDoctor_db            # default: MyDoctor_db
# GITHUB_DATA_BRANCH=main                 # default: main
